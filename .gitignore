
# Dependencies
node_modules/

# Build output
dist/
dist-ssr/
*.local

# Editor
.vscode/*
!.vscode/extensions.json
.DS_Store

# Rust / Tauri
/src-tauri/target/
/src-tauri/gen/

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Runtime data (never commit local app data)
/data/runtime/
*.db
*.db-journal
*.db-wal
*.db-shm

# Models (large binaries - never commit; READMEs stay tracked)
models/moonshine/*
!models/moonshine/README.md
models/vad/*
!models/vad/README.md

# ONNX Runtime shared library. Large, platform-specific, and not ours to
# redistribute from here — see /models/moonshine/README.md for how to get it.
/src-tauri/resources/*.dylib
/src-tauri/resources/*.so
/src-tauri/resources/*.dll
